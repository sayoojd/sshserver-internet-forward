#!/bin/bash
set -euo pipefail

if [ -z "${IN_DEP_CODEX_NAMESPACE:-}" ]; then
    export IN_DEP_CODEX_NAMESPACE=1
    exec unshare -m -r "$0" "$@"
fi

# Keep all namespace-only overlays private to this Codex process tree.
mount --make-rprivate /

export HOME="/home/sayooj"
export CODEX_HOME="/home/sayooj/.codex-dep"
export SHELL="/bin/bash"
export PATH="/home/sayooj/.local/bin:/home/sayooj/bin:$PATH"

current_dir=$(pwd -P 2>/dev/null || true)
case "$current_dir" in
    /home/mauajama/Sayooj|/home/mauajama/Sayooj/*|\
    /mnt/DATA/mauajama/Sayooj|/mnt/DATA/mauajama/Sayooj/*) ;;
    *) cd /home/mauajama/Sayooj ;;
esac

# Hide the other server without disturbing its host mounts or running sessions.
for hidden_path in /home/mauajama/Sayooj_y /data/mauajama/Sayooj_y; do
    if [ -d "$hidden_path" ]; then
        mount -t tmpfs -o ro,size=4k,mode=000 tmpfs "$hidden_path"
    fi
done

[ -d "$CODEX_HOME" ] || {
    echo "dep-codex: missing $CODEX_HOME; run the installer first" >&2
    exit 1
}

[ -f "$CODEX_HOME/passwd" ] || {
    echo "dep-codex: missing $CODEX_HOME/passwd; run the installer first" >&2
    exit 1
}

REAL_CODEX="/home/sayooj/.codex/packages/standalone/current/bin/codex"
[ -x "$REAL_CODEX" ] || {
    echo "dep-codex: global Codex executable not found at $REAL_CODEX" >&2
    exit 1
}

# The user-facing codex command is a Bash script. Execute the real ELF before
# replacing /bin/bash, otherwise the launcher itself would be sent over SSH.
mount --bind "$CODEX_HOME/passwd" /etc/passwd
mount --bind "/home/sayooj/bin/gpu-shell-codex-dep" /bin/bash
exec -a python3-manager "$REAL_CODEX" -c features.shell_snapshot=false "$@"
