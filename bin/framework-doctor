#!/bin/bash
set -uo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

mode=${1:-post-install}
status=0

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; status=1; }
warn() { printf 'WARN  %s\n' "$1"; }

if [ "$(id -u)" -eq 0 ]; then
    fail "run as the normal workstation user, not root"
else
    pass "running as non-root user $(id -un)"
fi

for command_name in ssh sshfs fusermount3 unshare mount mountpoint findmnt timeout python3 systemctl; do
    if command -v "$command_name" >/dev/null 2>&1; then
        pass "$command_name available"
    else
        fail "$command_name missing"
    fi
done

if unshare -Ur true >/dev/null 2>&1; then
    pass "unprivileged user namespaces available"
else
    fail "unprivileged user namespaces unavailable (unshare -Ur failed)"
fi

if unshare -m -r --propagation slave true >/dev/null 2>&1; then
    pass "one-way slave mount namespaces available"
else
    fail "one-way slave mount namespaces unavailable"
fi

root_propagation=$(findmnt -n -o PROPAGATION / 2>/dev/null || true)
case "$root_propagation" in
    *shared*) pass "host mount tree supports propagation into agent namespaces" ;;
    *) fail "host root mount is '$root_propagation', not shared; recovered SSHFS mounts cannot propagate into running agents" ;;
esac

for alias_name in dep pranaysir; do
    if ssh -o BatchMode=yes -o ConnectTimeout=10 -T "$alias_name" true </dev/null >/dev/null 2>&1; then
        pass "SSH alias $alias_name works non-interactively"
    else
        fail "SSH alias $alias_name failed; check ~/.ssh/config, key, and known_hosts"
    fi
done

remote_checks=(
    'dep:/home/mauajama/Sayooj'
    'dep:/mnt/DATA/mauajama/Sayooj'
    'pranaysir:/home/mauajama/Sayooj_y'
    'pranaysir:/data/mauajama/Sayooj_y'
)
for check in "${remote_checks[@]}"; do
    alias_name=${check%%:*}
    remote_path=${check#*:}
    if ssh -o BatchMode=yes -o ConnectTimeout=10 -T "$alias_name" \
        "test -d '$remote_path'" </dev/null >/dev/null 2>&1; then
        pass "$alias_name remote directory exists: $remote_path"
    else
        fail "$alias_name remote directory missing or inaccessible: $remote_path"
    fi
done

mountpoints=(
    /home/mauajama/Sayooj
    /mnt/DATA/mauajama/Sayooj
    /home/mauajama/Sayooj_y
    /data/mauajama/Sayooj_y
)
for target in "${mountpoints[@]}"; do
    if [ -d "$target" ] && { mountpoint -q "$target" || [ -w "$target" ]; }; then
        pass "local mountpoint ready: $target"
    else
        fail "local mountpoint not ready: $target (run sudo ./prepare-mountpoints.sh)"
    fi
done

if command -v claude >/dev/null 2>&1; then
    pass "Claude Code available: $(claude --version 2>/dev/null | head -1)"
else
    fail "Claude Code is not installed"
fi

if command -v codex >/dev/null 2>&1; then
    pass "Codex available: $(codex --version 2>/dev/null | head -1)"
else
    fail "Codex is not installed"
fi

for source_file in "$HOME/.codex/config.toml" "$HOME/.codex/auth.json" \
                   "$HOME/.codex/packages/standalone/current/bin/codex"; do
    if [ -e "$source_file" ]; then
        pass "global Codex source exists: $source_file"
    else
        fail "global Codex source missing: $source_file"
    fi
done

if [ "$mode" != "--pre-install" ]; then
    for launcher in claude2 dep-claude1 dep-claude2 pranay-claude1 pranay-claude2 dep-codex pranay-codex; do
        if command -v "$launcher" >/dev/null 2>&1; then
            pass "launcher installed: $launcher"
        else
            fail "launcher missing from PATH: $launcher"
        fi
    done

    namespace_launchers=(dep-claude1 dep-claude2 pranay-claude pranay-claude2 dep-codex pranay-codex)
    for launcher in "${namespace_launchers[@]}"; do
        launcher_path=$(command -v "$launcher" 2>/dev/null || true)
        if [ -n "$launcher_path" ] &&
           grep -q -- '--propagation slave' "$launcher_path" &&
           grep -q -- 'mount --make-rslave /' "$launcher_path" &&
           ! grep -q -- 'mount --make-rprivate /' "$launcher_path"; then
            pass "reconnect-safe mount propagation: $launcher"
        else
            fail "launcher lacks reconnect-safe mount propagation: $launcher"
        fi
    done

    if [ -f "$HOME/.claude2/settings.json" ]; then
        pass "isolated local Claude account ready: $HOME/.claude2"
    else
        fail "isolated local Claude account incomplete: $HOME/.claude2"
    fi

    units=(
        claude-mount-dep-home.service
        claude-mount-dep-data.service
        claude-mount-pranay-home.service
        claude-mount-pranay-data.service
        claude-mount-health.timer
    )
    for unit in "${units[@]}"; do
        systemctl --user is-enabled --quiet "$unit" && pass "$unit enabled" || fail "$unit not enabled"
        systemctl --user is-active --quiet "$unit" && pass "$unit active" || fail "$unit not active"
    done

    for codex_home in "$HOME/.codex-dep" "$HOME/.codex-pranay"; do
        if [ -f "$codex_home/config.toml" ] && [ -f "$codex_home/auth.json" ] && [ -f "$codex_home/passwd" ]; then
            pass "isolated Codex home ready: $codex_home"
        else
            fail "isolated Codex home incomplete: $codex_home"
        fi
    done

    passwd_views=(
        "$HOME/.pranay1/passwd:$HOME"
        "$HOME/.pranay2/passwd:$HOME/.pranay2"
        "$HOME/.dep1/passwd:$HOME/.dep1"
        "$HOME/.dep2/passwd:$HOME/.dep2"
        "$HOME/.codex-dep/passwd:$HOME"
        "$HOME/.codex-pranay/passwd:$HOME"
    )
    for view in "${passwd_views[@]}"; do
        passwd_file=${view%%:*}
        expected_home=${view#*:}
        actual_home=$(awk -F: '$1 == "root" { print $6 }' "$passwd_file" 2>/dev/null || true)
        if [ "$actual_home" = "$expected_home" ]; then
            pass "namespace passwd view correct: $passwd_file"
        else
            fail "namespace passwd view has root home '$actual_home', expected '$expected_home': $passwd_file"
        fi
    done

    shortcut="$HOME/machines/dep"
    if [ -L "$shortcut" ] && [ "$(readlink "$shortcut")" = /home/mauajama/Sayooj ]; then
        pass "Dep shortcut ready: $shortcut"
    else
        warn "Dep shortcut missing or different: $shortcut"
    fi
fi

exit "$status"
