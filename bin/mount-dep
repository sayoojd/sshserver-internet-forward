#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

mount_one() {
    local source=$1 target=$2
    if mountpoint -q "$target"; then
        if timeout 10 ls -A "$target" >/dev/null 2>&1; then
            return 0
        fi
        echo "Replacing stale SSHFS mount: $target" >&2
        fusermount3 -uz "$target" || return 1
    fi

    [ -d "$target" ] || { echo "Missing mountpoint: $target" >&2; return 1; }
    sshfs "$source" "$target" \
        -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,\
BatchMode=yes,ConnectTimeout=10
}

mount_one dep:/home/mauajama/Sayooj /home/mauajama/Sayooj
mount_one dep:/mnt/DATA/mauajama/Sayooj /mnt/DATA/mauajama/Sayooj
