#!/bin/bash
set -uo pipefail

healthy() {
    local target=$1
    mountpoint -q "$target" && timeout 5 ls -A "$target" >/dev/null 2>&1
}

recover() {
    local target=$1 unit=$2
    healthy "$target" && return 0

    # An active sshfs process with -o reconnect owns the original FUSE mount.
    # Never replace it merely because a short probe failed: processes whose cwd
    # is inside that mount would retain the detached old endpoint forever.
    active_state=$(systemctl --user show "$unit" -p ActiveState --value 2>/dev/null || true)
    case "$active_state" in
        active|activating|reloading|deactivating)
            echo "SSHFS temporarily unreadable; preserving active reconnecting mount: $target" >&2
            return 0
            ;;
    esac

    echo "Recovering dead SSHFS service ($active_state): $target" >&2
    if mountpoint -q "$target"; then
        fusermount3 -uz "$target" || return 1
    fi
    systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
    systemctl --user start "$unit" || return 1
    for _ in {1..20}; do
        healthy "$target" && return 0
        sleep 0.5
    done
    return 1
}

if [ "$#" -ne 0 ]; then
    [ "$#" -eq 2 ] || {
        echo "Usage: check-claude-mounts [mountpoint systemd-unit]" >&2
        exit 64
    }
    recover "$1" "$2"
    exit $?
fi

status=0
recover /home/mauajama/Sayooj_y claude-mount-pranay-home.service || status=1
recover /data/mauajama/Sayooj_y claude-mount-pranay-data.service || status=1
recover /home/mauajama/Sayooj claude-mount-dep-home.service || status=1
recover /mnt/DATA/mauajama/Sayooj claude-mount-dep-data.service || status=1
exit "$status"
