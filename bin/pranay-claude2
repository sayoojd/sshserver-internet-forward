#!/bin/bash
set -euo pipefail

export GPU_MIRROR_LOCAL_HOME="${GPU_MIRROR_LOCAL_HOME:-$HOME}"
LOCAL_HOME="$GPU_MIRROR_LOCAL_HOME"

if [ -z "${IN_PRANAY_NAMESPACE:-}" ]; then
    export IN_PRANAY_NAMESPACE=1
    exec unshare -m -r --propagation slave "$0" "$@"
fi

# Receive host SSHFS replacements while keeping namespace mounts one-way.
mount --make-rslave /

export HOME="$LOCAL_HOME/.pranay2"
export SHELL="/bin/bash"
export CLAUDE_CODE_SHELL="/bin/bash"
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export PATH="$LOCAL_HOME/.local/bin:$LOCAL_HOME/bin:$PATH"

current_dir=$(pwd -P 2>/dev/null || true)
case "$current_dir" in
    /home/mauajama/Sayooj_y|/home/mauajama/Sayooj_y/*|\
    /data/mauajama/Sayooj_y|/data/mauajama/Sayooj_y/*) ;;
    *) cd /home/mauajama/Sayooj_y ;;
esac
export GPU_MIRROR_REMOTE_CWD=$(pwd -P)

for hidden_path in /home/mauajama/Sayooj /mnt/DATA/mauajama/Sayooj; do
    if [ -d "$hidden_path" ]; then
        mount -t tmpfs -o ro,size=4k,mode=000 tmpfs "$hidden_path"
    fi
done

if [ -f "$HOME/passwd" ]; then
    mount --bind "$HOME/passwd" /etc/passwd
fi

mount --bind "$LOCAL_HOME/bin/gpu-shell-pranay" /bin/bash
exec claude --settings "$HOME/.claude/settings.json" "$@"
