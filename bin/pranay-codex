#!/bin/bash
set -euo pipefail

export GPU_MIRROR_LOCAL_HOME="${GPU_MIRROR_LOCAL_HOME:-$HOME}"
LOCAL_HOME="$GPU_MIRROR_LOCAL_HOME"

if [ -z "${IN_PRANAY_CODEX_NAMESPACE:-}" ]; then
    export IN_PRANAY_CODEX_NAMESPACE=1
    exec unshare -m -r --propagation slave "$0" "$@"
fi

# Receive host SSHFS unmount/remount events without propagating this session's
# hidden-path overlays back to the host or to another agent namespace.
mount --make-rslave /

export HOME="$LOCAL_HOME"
export CODEX_HOME="$LOCAL_HOME/.codex-pranay"
export SHELL="/bin/bash"
export PATH="$LOCAL_HOME/.local/bin:$LOCAL_HOME/bin:$PATH"

current_dir=$(pwd -P 2>/dev/null || true)
case "$current_dir" in
    /home/mauajama/Sayooj_y|/home/mauajama/Sayooj_y/*|\
    /data/mauajama/Sayooj_y|/data/mauajama/Sayooj_y/*) ;;
    *) cd /home/mauajama/Sayooj_y ;;
esac
export GPU_MIRROR_REMOTE_CWD=$(pwd -P)

# Hide the other server without disturbing its host mounts or running sessions.
for hidden_path in /home/mauajama/Sayooj /mnt/DATA/mauajama/Sayooj; do
    if [ -d "$hidden_path" ]; then
        mount -t tmpfs -o ro,size=4k,mode=000 tmpfs "$hidden_path"
    fi
done

[ -d "$CODEX_HOME" ] || {
    echo "pranay-codex: missing $CODEX_HOME; run the installer first" >&2
    exit 1
}

[ -f "$CODEX_HOME/passwd" ] || {
    echo "pranay-codex: missing $CODEX_HOME/passwd; run the installer first" >&2
    exit 1
}

REAL_CODEX="$LOCAL_HOME/.codex/packages/standalone/current/bin/codex"
[ -x "$REAL_CODEX" ] || {
    echo "pranay-codex: global Codex executable not found at $REAL_CODEX" >&2
    exit 1
}

# The user-facing codex command is a Bash script. Execute the real ELF before
# replacing /bin/bash, otherwise the launcher itself would be sent over SSH.
mount --bind "$CODEX_HOME/passwd" /etc/passwd
mount --bind "$LOCAL_HOME/bin/gpu-shell-codex-pranay" /bin/bash
exec -a python3-manager "$REAL_CODEX" \
    -c features.shell_snapshot=false \
    -c approval_policy=never \
    -c sandbox_mode=danger-full-access \
    -c memories.generate_memories=false \
    -c memories.use_memories=false \
    "$@"
