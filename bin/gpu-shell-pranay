#!/bin/sh
set -eu

# Avoid getcwd() on a detached FUSE cwd; the launcher records this canonical
# path before the agent starts.
LOCAL_DIR=${GPU_MIRROR_REMOTE_CWD:-}
if [ -z "$LOCAL_DIR" ]; then
    LOCAL_DIR=$(pwd -P)
fi

case "$LOCAL_DIR" in
    /home/mauajama/Sayooj_y|/home/mauajama/Sayooj_y/*|\
    /data/mauajama/Sayooj_y|/data/mauajama/Sayooj_y/*)
        REMOTE_DIR="$LOCAL_DIR"
        ;;
    *)
        echo "pranay-claude: refusing to run Bash outside the pranaysir roots:" >&2
        echo "  /home/mauajama/Sayooj_y" >&2
        echo "  /data/mauajama/Sayooj_y" >&2
        echo "Current directory: $LOCAL_DIR" >&2
        exit 64
        ;;
esac

CMD=""
INTERACTIVE=1

while [ "$#" -gt 0 ]; do
    case "$1" in
        -c)
            [ "$#" -ge 2 ] || { echo "pranay-claude: bash -c requires a command" >&2; exit 64; }
            CMD="$2"
            INTERACTIVE=0
            shift 2
            ;;
        -l|--login|-i|--interactive)
            shift
            ;;
        *)
            CMD="$*"
            INTERACTIVE=0
            break
            ;;
    esac
done

if [ "$INTERACTIVE" -eq 1 ] || [ -z "$CMD" ]; then
    exec ssh -q -t pranaysir "cd $(printf '%s' "$REMOTE_DIR" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/") && exec bash"
else
    exec ssh -q -T pranaysir "cd $(printf '%s' "$REMOTE_DIR" | sed "s/'/'\\\\''/g; s/^/'/; s/$/'/") && $CMD"
fi
