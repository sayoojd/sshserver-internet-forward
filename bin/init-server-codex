#!/bin/bash
set -euo pipefail

LOCAL_HOME="${GPU_MIRROR_LOCAL_HOME:-$HOME}"
SOURCE_HOME="$LOCAL_HOME/.codex"

initialize_home() {
    local server="$1"
    local target="$LOCAL_HOME/.codex-$server"

    mkdir -p "$target"
    chmod 700 "$target"

    if [ ! -e "$target/config.toml" ]; then
        cp "$SOURCE_HOME/config.toml" "$target/config.toml"
        case "$server" in
            dep)
                grep -Fq '[projects."/home/mauajama/Sayooj"]' "$target/config.toml" || \
                    printf '\n[projects."/home/mauajama/Sayooj"]\ntrust_level = "trusted"\n' >> "$target/config.toml"
                grep -Fq '[projects."/mnt/DATA/mauajama/Sayooj"]' "$target/config.toml" || \
                    printf '\n[projects."/mnt/DATA/mauajama/Sayooj"]\ntrust_level = "trusted"\n' >> "$target/config.toml"
                ;;
            pranay)
                grep -Fq '[projects."/home/mauajama/Sayooj_y"]' "$target/config.toml" || \
                    printf '\n[projects."/home/mauajama/Sayooj_y"]\ntrust_level = "trusted"\n' >> "$target/config.toml"
                grep -Fq '[projects."/data/mauajama/Sayooj_y"]' "$target/config.toml" || \
                    printf '\n[projects."/data/mauajama/Sayooj_y"]\ntrust_level = "trusted"\n' >> "$target/config.toml"
                ;;
        esac
        chmod 600 "$target/config.toml"
    fi

    "$LOCAL_HOME/bin/ensure-codex-memory-off" "$target/config.toml"
    "$LOCAL_HOME/bin/ensure-codex-permissions" "$target/config.toml"

    if [ ! -e "$target/auth.json" ]; then
        cp "$SOURCE_HOME/auth.json" "$target/auth.json"
        chmod 600 "$target/auth.json"
    fi

    cp /etc/passwd "$target/passwd"
    sed -i "s|^root:x:0:0:root:[^:]*:|root:x:0:0:root:$LOCAL_HOME:|" "$target/passwd"
    chmod 600 "$target/passwd"

    for copied_dir in skills plugins; do
        if [ -d "$SOURCE_HOME/$copied_dir" ] && [ ! -e "$target/$copied_dir" ]; then
            cp -a "$SOURCE_HOME/$copied_dir" "$target/$copied_dir"
        fi
    done

    echo "Initialized $target from the current global Codex setup"
}

initialize_home dep
initialize_home pranay
